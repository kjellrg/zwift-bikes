{
  "name": "zwift-bikes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run validate && nuxt build && node scripts/check-client-bundle.mjs",
    "validate": "npm run validate:supplements && npm run validate:events && npm run validate:speed-data && npm run validate:placements && npm run validate:upgrade-data && npm run validate:equipment-physics && npm run validate:race-draft && npm run validate:api-schemas && npm run validate:standings",
    "validate:supplements": "node scripts/supplement/extract.mjs --check",
    "supplement:extract": "node scripts/supplement/extract.mjs",
    "supplement:prune": "node scripts/supplement/extract.mjs --prune",
    "validate:upgrade-data": "node scripts/upgrade-levels/verify-upgrade-data.mjs",
    "validate:equipment-physics": "node scripts/equipment-physics/compute-equipment-physics.mjs --check",
    "equipment-physics:compute": "node scripts/equipment-physics/compute-equipment-physics.mjs",
    "validate:standings": "node scripts/standings/compute-standings.mjs --check",
    "standings:compute": "node scripts/standings/compute-standings.mjs",
    "speed-data:import-validation": "node scripts/zwiftinsider/import-validation-gaps.mjs",
    "dictionary:check": "node scripts/dictionary/check-game-dictionary.mjs",
    "validate:api-schemas": "node scripts/validate-api-schemas.mjs",
    "parity:recommend": "node scripts/recommend-parity/compare.mjs",
    "validate:events": "node scripts/events/validate-events.mjs",
    "validate:speed-data": "node scripts/validate-speed-data.mjs",
    "validate:placements": "node scripts/validate-placements.mjs",
    "validate:race-draft": "node scripts/race-draft/validate-race-draft.mjs && node scripts/race-draft/test-parse-zwiftpower-paste.mjs",
    "flags:pull": "node scripts/site-flags/site-flags.mjs pull",
    "flags:push": "node scripts/site-flags/site-flags.mjs push",
    "flags:diff": "node scripts/site-flags/site-flags.mjs diff",
    "events:add": "node scripts/events/add-race.mjs",
    "events:find-route": "node scripts/events/find-route.mjs",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/spell/generate-zwift-dict.mjs",
    "prepare": "husky",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "smoke": "node scripts/site-smoke/smoke.mjs",
    "spellcheck": "cspell --no-progress",
    "typecheck": "nuxt typecheck",
    "route-surfaces:polygons": "node scripts/route-surfaces/extract-surface-polygons.mjs",
    "route-surfaces:compute": "node scripts/route-surfaces/compute-route-surfaces.mjs",
    "segment-placements:compute": "node scripts/segment-placements/compute-segment-placements.mjs",
    "segment-streams:fetch": "node scripts/segment-placements/fetch-segment-streams.mjs",
    "audit:signatures": "node scripts/audit-signatures.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/robots": "^6.2.4",
    "@nuxtjs/sitemap": "^8.6.2",
    "@takumi-rs/core": "^2.16.2",
    "h3": "^1.15.11",
    "nuxt": "^4.6.2",
    "nuxt-og-image": "^6.10.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zwift-data": "^2.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "cspell": "^10.4.0",
    "devalue": "^5.9.4",
    "esbuild": "^0.27.7",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.0"
  }
}
