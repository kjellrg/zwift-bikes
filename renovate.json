{
  "extends": [
    "github>nuxt/renovate-config-nuxt"
  ],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 1 * *"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [{
    "matchDepTypes": ["resolutions"],
    "enabled": false
  }],
  "postUpdateOptions": ["npmDedupe"]
}
