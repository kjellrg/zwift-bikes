# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Auto-generated at repo root by the nitro azure preset on every build -
# the real config lives in the nitro.azure.config block in nuxt.config.ts
/staticwebapp.config.json

# Node dependencies
node_modules

# Logs
logs
*.log

# Spellcheck dictionary generated at postinstall from the zwift-data package
# by scripts/spell/generate-zwift-dict.mjs - derived, not authored
.cspell/zwift-data-words.txt

# Race draft calibration dataset - per-rider race results stay local-only.
# Summary statistics and the charts live in docs/race-drafting.md; the format is
# documented by scripts/race-draft/field-results.sample.json.
scripts/race-draft/field-results.json

# Segment-effort validation set - one rider's exact distance/time/power per
# route lap, also local-only. Format: scripts/race-draft/segment-efforts.sample.json.
scripts/race-draft/segment-efforts.json

# Runtime site flags - the VALUES live in KV (docs/site-flags.md), and this
# file is just the local editing copy `npm run flags:pull/push` works on.
# Deliberately untracked: committing it would send every flags change through
# the pre-commit build and the deploy workflow, the exact loop the feature
# exists to bypass. The schema and an example stay in git.
infra/site-flags.json

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Claude Code local/machine-specific state - not meant to be shared via git
**/.claude/settings.local.json
**/.claude/*.lock
**/.claude/scheduled_tasks.json
**/.claude/routines/.state/
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json

# Skilld references (recreated by `skilld install`)
.skilld
.claude/skills/nuxtjs-*
.claude/skills/skilld-*
CLAUDE.md
# Wrangler local dev state
.wrangler
